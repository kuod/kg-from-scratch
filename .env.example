NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

GROQ_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

LLM_MODEL=llama-3.3-70b-versatile
# Anthropic fallback used if Groq fails (part of the extraction cache key)
LLM_FALLBACK_MODEL=claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-4-6
EMBED_MODEL=pritamdeka/PubMedBERT-mnli-snli-scinli-scitail-mednli-stsb
SCISPACY_MODEL=en_core_sci_lg

USE_LOGPROB_CI=false
